{
    "manifest_version": 3,
    "name": "敬語変換ツール",
    "version": "1.0",
    "description": "相手に応じてメッセージを敬語に変換するツール",
    "permissions": ["storage", "clipboardWrite"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
      }
    }
  }